# Server Environment Configuration
NODE_ENV=development # development | test | production
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/votexa?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votexa
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Fallback Secret (for dev/testing)
JWT_SECRET=votexa-super-secret-jwt-token-key-for-development-32-chars

# Security & Limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Logging
LOG_LEVEL=debug

