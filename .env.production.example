# ==============================================================================
# Votexa Production Environment Configuration Template
# COPY TO .env.production AND CONFIGURE SECRETS BEFORE DEPLOYMENT
# ==============================================================================

# Node Runtime Configuration
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database Infrastructure (PostgreSQL 16 with SSL)
POSTGRES_DB=votexa_prod
POSTGRES_USER=votexa_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_64_CHAR
DATABASE_URL=postgresql://votexa_admin:REPLACE_WITH_STRONG_RANDOM_PASSWORD_64_CHAR@postgres:5432/votexa_prod?sslmode=require

# Supabase Auth & JWT Validation
# Project URL: https://inuleocyvdzcspopiipl.supabase.co
SUPABASE_URL=https://inuleocyvdzcspopiipl.supabase.co
SUPABASE_ANON_KEY=sb_publishable_PfeFM4jmSey-Kggq5UcBlQ_-CjhB7MB
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY_FROM_DASHBOARD
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET_FROM_DASHBOARD

# Commercial Platform Revenue Sharing Rules
# Strict 40% Platform / 60% Organiser Split (4000 Basis Points)
PLATFORM_COMMISSION_BPS=4000
COMMISSION_ROUNDING_MODE=BANKERS

# Safaricom Daraja M-Pesa C2B / STK Push Configuration
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=REPLACE_WITH_DARAJA_LIVE_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_DARAJA_LIVE_CONSUMER_SECRET
MPESA_PASSKEY=REPLACE_WITH_DARAJA_LIVE_PASSKEY
MPESA_SHORTCODE=REPLACE_WITH_BUSINESS_PAYBILL_NUMBER
MPESA_CALLBACK_URL=https://votexa.io/api/v1/payments/mpesa/callback

# Safaricom Daraja M-Pesa B2C Automated Disbursement Configuration
MPESA_B2C_SHORTCODE=REPLACE_WITH_B2C_SHORTCODE
MPESA_B2C_INITIATOR_NAME=REPLACE_WITH_DARAJA_B2C_INITIATOR_USERNAME
MPESA_B2C_SECURITY_CREDENTIAL=REPLACE_WITH_RSA_ENCRYPTED_PASSWORD_CREDENTIAL
MPESA_B2C_RESULT_URL=https://votexa.io/api/v1/payments/b2c/callback
MPESA_B2C_TIMEOUT_URL=https://votexa.io/api/v1/payments/b2c/timeout
MPESA_B2C_SIMULATION_MODE=false

# Security & CORS Controls
CORS_ORIGIN=https://votexa.io,https://app.votexa.io
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Audit Logging & Retention
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_IMMUTABLE=true

