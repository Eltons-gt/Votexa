# ==============================================================================
# Votexa Platform - Environment Configuration Template
# Copy this file to .env in each corresponding workspace (or define at root)
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development # development | test | production
PORT=5000

# --- Client Configuration ---
VITE_API_URL=http://localhost:5000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Backend Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/votexa?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=votexa
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20

# --- Supabase Auth & Admin Backend ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-votexa

# --- CORS & Security ---
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100

# --- Payments Gateway & M-Pesa Daraja ---
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

MPESA_ENVIRONMENT=sandbox # sandbox | production
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.votexa.io/api/v1/webhooks/mpesa

# --- Logging & Telemetry ---
LOG_LEVEL=debug # debug | info | warn | error

